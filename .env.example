# Copy to .env and fill with real values. Vite exposes only VITE_* vars to the client.

# Base URL of the backend API (no trailing slash), e.g. https://api.yourdomain.com
VITE_API_URL=


# Conversion request numbering (first request id)
CONVERSION_ID_START=100

# Console base URL used in notification emails
CONSOLE_URL=https://admin.kgrpartnersltd.com
