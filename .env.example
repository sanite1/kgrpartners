# Copy to .env and fill with real values. Vite exposes only VITE_* vars to the client.

# Base URL of the backend API (no trailing slash), e.g. https://api.yourdomain.com
VITE_API_URL=

# MongoDB ObjectId (24-char hex) of the KGR Partners company profile
# used by the public contact endpoint: POST {VITE_API_URL}/api/contact/:companyId
VITE_CONTACT_COMPANY_ID=
